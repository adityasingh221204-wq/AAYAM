# AAYAM Environment Configuration Template
# Copy this file to .env for local adjustments.
# Never commit actual credentials or secrets to version control.

APP_ENV=development
APP_PORT=8501
APP_HOST=0.0.0.0

# Optional Data Path Overrides
DATA_DIR=data
PROCESSED_DATA_DIR=data/processed

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_DEBUG=false
